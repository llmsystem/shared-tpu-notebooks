# ==============================================================================
# shared-tpu-notebooks: Centralized Environment Configuration Template
# ==============================================================================
# Copy this file to `config.env` and customize for your GCP environment:
#   cp config.env.example config.env
#
# Once config.env exists, the Makefile and all scripts will automatically load
# these values, so you can run `make cluster`, `make hub`, etc., without flags.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Core Settings (Required)
# ------------------------------------------------------------------------------
# Your Google Cloud Project ID (not its display name)
PROJECT=your-gcp-project-id

# Target GCP region for GKE cluster and Cloud TPUs (e.g. us-west4)
REGION=us-west4

# GKE Autopilot Cluster Name
CLUSTER=tpu-notebooks

# Kubernetes namespace for the JupyterHub and TPU notebooks
NAMESPACE=llmsys

# ------------------------------------------------------------------------------
# 2. Concurrent TPU Notebook Limit
# ------------------------------------------------------------------------------
# Each open student or TA notebook uses one v5e chip. Include both groups.
# The Kubernetes ResourceQuota rejects spawns above this number; it does not queue them.
MAX_TPU_NOTEBOOKS=40

# ------------------------------------------------------------------------------
# 3. Identity-Aware Proxy (IAP) & Domain Access
# ------------------------------------------------------------------------------
# Custom domain name for JupyterHub (use duckdns if CMU doesn't provide a dedicated dns for it)
DOMAIN=""

# Use a new name when switching an existing Hub to another domain. The old
# certificate stays attached until the new one is active.
HUB_CERT_NAME=hub-cert

# Google Group for enrolled students (e.g. group:students@your-university.edu)
STUDENT_GROUP=""

# Google Group for course Teaching Assistants (e.g. group:tas@your-university.edu)
TA_GROUP=""

# Space or comma-separated list of Admin user accounts (e.g. user:prof@your-university.edu)
ADMIN_USERS=""

# Estimated v5e TPU chip-hour cost shown in the JupyterHub admin console (USD).
# Set this to the current effective rate for your region and billing arrangement.
TPU_HOURLY_USD=1.35

# Default all-time estimated TPU cost limit per student (USD). Admins can set
# an individual override on the Hub Admin page.
STUDENT_TPU_BUDGET_USD=150

# Space or comma-separated list of individual test accounts
TEST_ACCOUNTS=""
